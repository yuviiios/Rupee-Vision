# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
# Every variable is optional; the defaults shown are what the app uses.

# --- Server ---
RUPEEVISION_HOST=127.0.0.1
RUPEEVISION_PORT=5000

# SECURITY: enables the Werkzeug interactive debugger, which permits arbitrary
# code execution on any request. Keep this false unless you are on localhost.
RUPEEVISION_DEBUG=false

# --- Observability ---
# One of CRITICAL, ERROR, WARNING, INFO, DEBUG.
RUPEEVISION_LOG_LEVEL=INFO
# true emits one JSON object per line (production); false is readable locally.
RUPEEVISION_LOG_JSON=true

# --- Security ---
# CORS allowlist, comma-separated. Do not use "*": the API is unauthenticated.
RUPEEVISION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Flask-Limiter expression, e.g. "60 per minute" or "1000/hour".
RUPEEVISION_RATE_LIMIT=60 per minute
# Maximum accepted request body, in bytes.
RUPEEVISION_MAX_CONTENT_LENGTH=16384

# --- Data and artifacts ---
RUPEEVISION_DATA_PATH=data/newdataset.csv
RUPEEVISION_MODEL_DIR=artifacts

# --- Performance ---
# 0 disables forecast memoisation.
RUPEEVISION_FORECAST_CACHE_SIZE=8
# /ready reports not_ready once the newest observation is older than this.
RUPEEVISION_MAX_DATA_STALENESS_DAYS=7

# --- External APIs (Finnhub) ---
# Get free key from https://finnhub.io/register
RUPEEVISION_FINNHUB_API_KEY=
# Cache TTL for market intelligence features (sentiment, events, correlation), in seconds.
RUPEEVISION_FEATURE_CACHE_TTL_SECONDS=3600
